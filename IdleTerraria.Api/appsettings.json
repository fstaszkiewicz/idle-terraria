{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=IdleTerrariaDB;Username=postgres;"
  },
  "GameRules": {
    "MaxIdleHours": 12,
    "BaseHuntingCycleSeconds": 5,
    "BaseExpPerCycle": 15,
    "BaseExpRequirementForLevelUp": 100,
    "ExpRequirementMultiplier": 1.5
  },
  "Jwt": {
    "Issuer": "IdleTerraria.Api",
    "Audience": "IdleTerraria.Client",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"

}